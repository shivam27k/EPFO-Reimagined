DATABASE_URL=file:./.data/epf-sahayak.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Leave blank to use the model default: cedar for gpt-4o-mini-tts; onyx for tts-1 or tts-1-hd.
# A nonblank override must be supported by the selected TTS model.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_VOICE=cedar
OPENAI_REALTIME_VAD=semantic_vad
